---
import BaseLayout from '../layouts/BaseLayout.astro';
const { lang, t } = Astro.props;
---

<BaseLayout title={t.pageTitle} description={t.pageDescription} lang={lang}>
  <main class="links-shell">
    <article class="so-neo-card so-bg-cream links-card">
      <header class="links-profile">
        <div class="links-avatar" aria-hidden="true">{t.avatar}</div>
        <div>
          <p class="links-kicker">{t.profileKicker}</p>
          <h1>{t.profileNameFirst}<br />{t.profileNameLast}</h1>
          <p class="links-role">{t.profileRole}</p>
        </div>
      </header>

      <div class="so-status-bar so-bg-green" role="status" aria-label={t.statusAriaLabel}>
        <span>{t.statusSignal}</span>
        <span>{t.statusChannel}</span>
      </div>

      <nav class="links-list" aria-label={t.linksAriaLabel}>
        <a class="so-neo-btn so-bg-orange links-button" href={t.portfolioLink}>
          <span>{t.portfolioText}</span><span aria-hidden="true">↗</span>
        </a>
        <a class="so-neo-btn so-bg-yellow links-button" href={t.youtubeLink}>
          <span>{t.youtubeText}</span><span aria-hidden="true">↗</span>
        </a>
        <a class="so-neo-btn so-bg-cream links-button" href={t.tiktokLink}>
          <span>{t.tiktokText}</span><span aria-hidden="true">↗</span>
        </a>
        <a class="so-neo-btn so-bg-green links-button" href={t.emailLink}>
          <span>{t.emailText}</span><span aria-hidden="true">↗</span>
        </a>
        <a class="so-neo-btn so-bg-teal links-button" href={t.githubLink} target="_blank" rel="noreferrer">
          <span>{t.githubText}</span><span aria-hidden="true">↗</span>
        </a>
      </nav>

      <section class="so-data-panel so-bg-night links-readout" aria-labelledby="readout-title">
        <div class="so-card-header"><span class="so-mono-text" id="readout-title">{t.readoutHeader}</span></div>
        <dl>
          <div><dt>{t.ageLabel}</dt><dd>{t.ageValue}</dd></div>
          <div><dt>{t.primaryLabel}</dt><dd>{t.primaryValue}</dd></div>
          <div><dt>{t.statusLabel}</dt><dd>{t.statusValue}</dd></div>
        </dl>
      </section>

      <footer class="links-footer so-metadata">
        <span>{t.footerDeveloper}</span>
        <span>{t.footerResponseTime}</span>
      </footer>
    </article>
  </main>
</BaseLayout>
